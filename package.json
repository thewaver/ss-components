{
    "name": "@thewaver/ss-components",
    "type": "module",
    "version": "0.0.1",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./styles.css": "./dist/index.css",
        "./package.json": "./package.json"
    },
    "sideEffects": [
        "**/*.css"
    ],
    "files": [
        "dist"
    ],
    "license": "MIT",
    "scripts": {
        "build:lib": "vite build --config ./vite.lib.config.ts && tsup src/Lib/index.ts --format esm --dts-only",
        "build:playground": "vite build --config ./vite.config.ts",
        "build:all": "npm run build:lib && npm run build:playground",
        "dev": "vite build --config ./vite.lib.config.ts --watch",
        "preview": "vite preview --config ./vite.config.ts",
        "start": "vite --config ./vite.config.ts --host",
        "verify:dom": "node verify/main.js",
        "format": "prettier --write ."
    },
    "dependencies": {
        "colorthief": "^3.5.0"
    },
    "devDependencies": {
        "@solidjs/router": "^1.0.0",
        "@thewaver/ss-utils": "^0.0.19",
        "@trivago/prettier-plugin-sort-imports": "^6.0.2",
        "@vanilla-extract/css": "^1.21.2",
        "@vanilla-extract/dynamic": "^2.1.5",
        "@vanilla-extract/vite-plugin": "^5.2.6",
        "prettier": "^3.9.5",
        "shiki": "^4.4.2",
        "solid-js": "^1.9.14",
        "tsup": "^8.5.1",
        "typescript": "^6.0.3",
        "vite": "^8.2.0",
        "vite-plugin-checker": "^0.14.5",
        "vite-plugin-solid": "^2.11.14"
    },
    "peerDependencies": {
        "@thewaver/ss-utils": "^0.0.19",
        "solid-js": "^1.9.14"
    },
    "prettier": {
        "tabWidth": 4,
        "printWidth": 120,
        "quoteProps": "consistent",
        "endOfLine": "auto",
        "plugins": [
            "@trivago/prettier-plugin-sort-imports"
        ],
        "importOrder": [
            "^[a-z]",
            "^@",
            "^[./](?!.*\\.css$)",
            ".*\\.css$"
        ],
        "importOrderSeparation": true,
        "importOrderSortSpecifiers": true
    }
}
